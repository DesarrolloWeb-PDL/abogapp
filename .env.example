# Copy this file to .env.local and paste your real values there.
# .env.local is git-ignored (`.env*` is ignored, `.env.example` is the only
# exception) — never commit real keys.

# ---------------------------------------------------------------------------
# Supabase — Auth + Postgres (see replica/backend.md).
# Create the project yourself at https://supabase.com, then copy the values
# from Project Settings → API. With these absent the app runs on the fake
# data layer (DATA_DRIVER=fake, the default) so dev and unit tests keep working.
# ---------------------------------------------------------------------------

# Project URL (public): https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (public): safe in the browser — RLS is the guard.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (SERVER ONLY): bypasses RLS. Used exclusively by the
# WhatsApp webhook writer (lib/supabase/service.ts). NEVER prefix with
# NEXT_PUBLIC_ and never import it from a component under app/ or components/.
SUPABASE_SECRET_KEY=

# Optional override for the data driver: "supabase" | "fake".
# Omitted → "supabase" when both public vars above are set, else "fake".
DATA_DRIVER=

# ---------------------------------------------------------------------------
# Meta WhatsApp Business Cloud API — Module A (assumption).
# Both routes answer 503 without them.
# ---------------------------------------------------------------------------

# Value you choose when you register the webhook in the Meta dashboard.
# Used by GET /api/webhooks/whatsapp for the hub.verify_token handshake.
WHATSAPP_VERIFY_TOKEN=

# App Secret from the Meta app dashboard. Signs every delivery:
# X-Hub-Signature-256 is HMAC-SHA256 of the raw body with this value.
WHATSAPP_APP_SECRET=
